# =====================================================================
# SERVERINKA GUARDIAN — KONFIGURASI
# Salin file ini menjadi .env (development) atau /etc/serverinka/guardian.env (production)
# dan isi nilainya.
# JANGAN commit file .env ke version control!
# =====================================================================

# ---- TELEGRAM --------------------------------------------------------
# Token bot dari @BotFather (WAJIB)
TELEGRAM_BOT_TOKEN=8683824514:AAHx1KGn6dBt8LhTkhz9mUsmStyyjnWht2Q

# Telegram User ID super admin, pisahkan dengan koma jika lebih dari satu (WAJIB)
TELEGRAM_ADMIN_USER_IDS=7896674035

# Mode koneksi Telegram: polling (default) atau webhook
TELEGRAM_MODE=polling

# Konfigurasi webhook (hanya jika TELEGRAM_MODE=webhook)
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/webhook
TELEGRAM_WEBHOOK_PORT=8443
TELEGRAM_WEBHOOK_SECRET=change_this_to_random_secret

# ---- DATABASE --------------------------------------------------------
# Path ke file database SQLite
DATABASE_PATH=./guardian.db

# ---- LOGGING ---------------------------------------------------------
# Level log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Path ke file log (kosongkan untuk hanya ke stdout/journald)
LOG_FILE_PATH=

# ---- SCHEDULER -------------------------------------------------------
# Interval pengecekan alert dalam detik (default: 60)
SCHEDULER_ALERT_INTERVAL_SECONDS=60

# ---- RATE LIMITING ---------------------------------------------------
# Maksimal perintah per window per user (default: 30)
RATE_LIMIT_COMMANDS_PER_WINDOW=30

# Durasi window dalam detik (default: 60)
RATE_LIMIT_WINDOW_SECONDS=60

# ---- DOCKER ----------------------------------------------------------
# Aktifkan integrasi Docker (true/false)
DOCKER_ENABLED=true

# ---- AI INTEGRATION (GOOGLE GEMINI 2.5 FLASH) ------------------------
# Provider AI: gemini (default), disabled, openai, ollama
AI_PROVIDER=gemini

# Model AI Google Gemini resmi (default: gemini-2.5-flash)
AI_MODEL=gemini-2.5-flash

# Catatan: API Key Gemini kini disimpan secara aman di SQLite Key Pool VPS.
# Tambahkan 100+ API Key langsung lewat Telegram dengan perintah:
# /ai addkey AIzaSyYourKey1 AIzaSyYourKey2 ...

# ---- EXTERNAL SERVICES & SECONDARY BACKUP DATABASE -------------------
# NewsAPI Key untuk Berita Terkini (https://newsapi.org/)
NEWS_API_KEY=your_news_api_key_here

# OpenWeatherMap Key untuk Prakiraan Cuaca Real-time (https://home.openweathermap.org/)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Neon PostgreSQL Database sebagai Database Backup Kedua untuk AI Pool & Memori
NEON_DATABASE_URL=postgresql://neondb_owner:your_neon_password@ep-odd-resonance-azzyhzdu-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require



# ---- BACKUP ----------------------------------------------------------
# Aktifkan backup otomatis (true/false)
BACKUP_ENABLED=true

# Jumlah hari retensi backup (default: 7)
BACKUP_RETENTION_DAYS=7

# Path ke folder backup
BACKUP_PATH=./backups

# ---- AUDIT LOG -------------------------------------------------------
# Jumlah hari retensi audit log (default: 90)
AUDIT_LOG_RETENTION_DAYS=90

# ---- PLUGINS ---------------------------------------------------------
# Plugin yang dinonaktifkan, pisahkan dengan koma (kosong = semua aktif)
DISABLED_PLUGINS=

# ---- WEB PANEL (Telegram Mini App) -----------------------------------
# Aktifkan Web Panel API (true/false)
WEBPANEL_ENABLED=true

# Host dan port Web Panel API server
WEBPANEL_HOST=0.0.0.0
WEBPANEL_PORT=8080

# URL publik Web Panel (WAJIB diisi agar tombol Mini App berfungsi)
# Contoh: https://vps.ekasyarifmaulana.com:8080
# Atau pakai IP: http://123.456.789.0:8080 (hanya untuk testing/dev)
WEBPANEL_URL=https://vps.ekasyarifmaulana.com:8080

# ---- ADVANCED --------------------------------------------------------
# Timeout koneksi ke Telegram API (detik)
CONNECT_TIMEOUT=10
READ_TIMEOUT=10
WRITE_TIMEOUT=10
POOL_TIMEOUT=10
